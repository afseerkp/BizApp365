# Copy this file to .env and fill in the values. Never commit .env.

# ---------- Server ----------
PORT=3100
# Public address is <PUBLIC_SUBDOMAIN>.bizapp365.com (used by deploy.sh; change with --subdomain)
PUBLIC_SUBDOMAIN=

# ---------- OpenRouter (AI) ----------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Pick a model with "Tools" support from https://openrouter.ai/models (free ones end in :free)
OPENROUTER_MODEL=
# Optional: comma-separated backups if the main model is busy or down
OPENROUTER_FALLBACK_MODELS=

# ---------- WhatsApp Cloud API (Meta) ----------
# From developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any secret string you invent; type the same value in the Meta webhook settings
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret. Required in production (checks webhooks really come from Meta)
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
# Optional while testing: only reply to these numbers (country code, digits only, comma-separated)
WHATSAPP_ALLOWED_NUMBERS=

# ---------- MCP server (your tools) ----------
# Use ONE of these two options.
# Option A: MCP server reachable over HTTP. For the BizApp365 ERP (see README step 3):
#   MCP_SERVER_URL=http://localhost:5001/api/mcp-server
#   MCP_AUTH_TOKEN=<same value as MCP_SERVER_TOKEN in the ERP backend .env>
MCP_SERVER_URL=
MCP_AUTH_TOKEN=
# Option B: MCP server started as a local process (this one runs the included demo).
# Clear both lines when you use Option A.
MCP_SERVER_COMMAND=node
MCP_SERVER_ARGS=examples/demo-mcp-server.js
MCP_SERVER_CWD=
# Optional: comma-separated list of the only tools the bot may use (empty = all tools).
# Leave empty for the BizApp365 ERP: it gives each sender (customer / salesman / manager) only their role's tools.
MCP_ALLOWED_TOOLS=

# ---------- Behaviour (optional) ----------
# AI_SYSTEM_PROMPT=
AI_MAX_TOOL_ROUNDS=5
# Longest AI reply in tokens (also limits what OpenRouter reserves from your credit)
AI_MAX_TOKENS=1500
AI_TIMEOUT_MS=60000
HISTORY_MAX_MESSAGES=12
HISTORY_TTL_MINUTES=30
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_MINUTES=10
